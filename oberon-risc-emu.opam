# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Bit-exact OCaml port of the Oberon RISC emulator"
description: """
An OCaml port of Peter De Wachter's oberon-risc-emu, an emulator for the
RISC5 machine that runs Niklaus Wirth's Project Oberon (2013). Uses tsdl
(SDL2) for the window, rendering, and input."""
maintainer: ["zxygentoo@gmail.com"]
authors: ["zxy"]
license: "ISC"
homepage: "https://github.com/zxygentoo/oberon-risc-emu-ocaml"
bug-reports: "https://github.com/zxygentoo/oberon-risc-emu-ocaml/issues"
depends: [
  "dune" {>= "3.0"}
  "ocaml" {>= "5.1"}
  "tsdl"
  "imagelib"
  "crunch" {build}
  "qcheck-core" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/zxygentoo/oberon-risc-emu-ocaml.git"
