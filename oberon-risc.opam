# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis:
  "Bit-exact emulator core for Wirth's RISC5 machine (Project Oberon)"
description: """
The RISC5 machine that runs Niklaus Wirth's Project Oberon (2013), as a
library: CPU and software floating point, the memory map and MMIO, the SPI
SD card, serial and PCLink, the clipboard bridge, the instruction codec, and a
deterministic headless driver. A port of Peter De Wachter's oberon-risc-emu,
verified against its C reference instruction by instruction. Needs nothing
beyond the OCaml distribution."""
maintainer: ["zxy <zxygentoo@gmail.com>"]
authors: ["zxy <zxygentoo@gmail.com>"]
license: "ISC"
homepage: "https://github.com/zxygentoo/oberon-risc-emu-ocaml"
bug-reports: "https://github.com/zxygentoo/oberon-risc-emu-ocaml/issues"
depends: [
  "dune" {>= "3.0"}
  "ocaml" {>= "5.1"}
  "qcheck-core" {>= "0.90" & with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/zxygentoo/oberon-risc-emu-ocaml.git"
x-maintenance-intent: ["(latest)"]
