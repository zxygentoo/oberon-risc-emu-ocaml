# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis:
  "Host tools for Project Oberon disk images: converters, extractor, image builders"
description: """
ob2txt / txt2ob convert Oberon text to and from host text; extract-source
unpacks a build-ready source tree from a disk image; build-po-image and
build-eo-image compile a tree into a bootable Project Oberon 2013 or Extended
Oberon image, driving the Oberon compiler headless with the bootstrap
toolchain embedded. Also oat, an experimental client for driving a live
Oberon over a serial line (outside the stability promise)."""
maintainer: ["zxy <zxygentoo@gmail.com>"]
authors: ["zxy <zxygentoo@gmail.com>"]
license: "ISC"
homepage: "https://github.com/zxygentoo/oberon-risc-emu-ocaml"
bug-reports: "https://github.com/zxygentoo/oberon-risc-emu-ocaml/issues"
depends: [
  "dune" {>= "3.0"}
  "ocaml" {>= "5.1"}
  "oberon-risc" {= version}
  "crunch" {>= "3.3.0" & build}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/zxygentoo/oberon-risc-emu-ocaml.git"
x-maintenance-intent: ["(latest)"]
