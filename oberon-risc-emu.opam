# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis:
  "SDL2 frontend for the oberon-risc RISC5 emulator: the risc command"
description: """
The `risc` command: boots a Project Oberon disk image in a window (tsdl/SDL2),
with the C frontend's options and hotkeys, PNG screenshots, a raw serial line,
and a deterministic headless mode that prints the boot's FNV-1a hashes."""
maintainer: ["zxy <zxygentoo@gmail.com>"]
authors: ["zxy <zxygentoo@gmail.com>"]
license: "ISC"
homepage: "https://github.com/zxygentoo/oberon-risc-emu-ocaml"
bug-reports: "https://github.com/zxygentoo/oberon-risc-emu-ocaml/issues"
depends: [
  "dune" {>= "3.0"}
  "ocaml" {>= "5.1"}
  "oberon-risc" {= version}
  "tsdl" {>= "1.0.0"}
  "imagelib" {>= "20210511"}
  "qcheck-core" {>= "0.90" & with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/zxygentoo/oberon-risc-emu-ocaml.git"
x-maintenance-intent: ["(latest)"]
