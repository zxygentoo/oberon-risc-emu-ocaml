; Core tests (risc_core only) — including the vendored FP vectors and the boot
; golden, which need their data files as deps.

(tests
 (names
  test_risc
  test_himem
  test_pclink
  test_clipboard
  test_disk
  test_raw_serial
  test_fp_vectors
  test_boot)
 (libraries risc_core unix test_harness)
 (deps data/fp_vectors.txt ../DiskImage/Oberon-2020-08-18.dsk))

; Frontend tests (the testable bin library + tsdl; no SDL_Init at runtime).
; test_screenshot decodes captures back through imagelib's own PNG reader.

(tests
 (names test_ps2 test_cli test_scale test_hotkeys test_screenshot)
 (libraries oberon_frontend risc_core tsdl imagelib test_harness))

; Instruction-codec tests (QCheck) — the shared Risc5_isa encode/decode + the
; differential check of encode against the hand-rolled golden encoders.

(test
 (name test_risc5_isa)
 (libraries risc_core qcheck-core qcheck-core.runner)
 ; dune doesn't track env vars by default; without this a cached success would
 ; ignore a later QCHECK_SEED.
 (deps
  (env_var QCHECK_SEED)))

; Property-based tests (QCheck) — spans the core and frontend.

(test
 (name test_prop)
 (libraries
  risc_core
  oberon_frontend
  tsdl
  unix
  qcheck-core
  qcheck-core.runner
  test_harness)
 (deps
  (env_var QCHECK_SEED)))

; Host-tool tests (oberon_tools): converters, .packonly, FS reader + extractor,
; resolver, the shared CLI walker, and the fs helpers.

(tests
 (names
  test_convert
  test_packonly
  test_image
  test_resolve
  test_tool_cli
  test_fsutil)
 (libraries oberon_tools test_harness))

; oat tests (the serial client for AgentTool.Mod): the wire codec + retry
; policy + full exchanges over host pipes (io), the byte channel over host
; pipes with forked children playing the device (device), the typed operations
; over an in-memory wire-typed fake (tool_call), CLI parsing and response rendering
; (cli), and the error contract (error). The live battery against a booted
; image is separate: test/integration.sh, via `make test-po`/`test-eo`.

(tests
 (names
  test_oat_io
  test_oat_device
  test_oat_tool_call
  test_oat_cli
  test_oat_error)
 (libraries oat unix test_harness))

; Embedded-seed structural checks (risc_core for boot_inner_core).

(test
 (name test_seed)
 (libraries oberon_tools risc_core test_harness))

; Pipeline filesystem-helper tests (need unix for mkdir/getpid).

(test
 (name test_pipeline)
 (libraries oberon_tools unix test_harness))

; Shim ABI unit tests.

(test
 (name test_shim)
 (libraries risc_core test_harness))

; End-to-end image-builder round-trip (opt-in: self-skips unless OBERON_ROUNDTRIP
; is set, since it boots the shim and compiles the whole system).

(test
 (name test_build_roundtrip)
 (libraries oberon_tools unix)
 ; env_var: without it, dune's cached "skipped" success would replay even when
 ; OBERON_ROUNDTRIP=1 is set later, silently never running the roundtrip.
 (deps
  (env_var OBERON_ROUNDTRIP))
 (action
  (run %{test} %{dep:../DiskImage/Oberon-2020-08-18.dsk})))
