; The frontend helpers live in a (wrapped false) library so the tests can reach
; Ps2 / Cli / Render directly; the executable is just the entry point.

(library
 (name oberon_frontend)
 (modules ps2 render cli sdl_clipboard screenshot app)
 (wrapped false)
 (libraries oberon-risc tsdl imagelib unix))

(executable
 (name risc)
 (public_name risc)
 (package oberon-risc-emu)
 (modules risc)
 (libraries oberon_frontend oberon-risc tsdl unix))
